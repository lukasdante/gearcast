// Capture-only Worker config: same code as worker/wrangler.jsonc, but LOCAL ONLY.
// - D1 / R2 use fake ids/names, so even an accidental `--remote` cannot reach production data.
// - No routes / custom domain, workers_dev off: this config can't be deployed over the real site by mistake.
// - Vectorize (VEC) is deliberately NOT bound: search never calls it (dense ranking uses the copy in R2), and the
//   upload/delete paths' VEC.upsert / VEC.deleteByIds are wrapped in try/catch, so nothing can be indexed remotely.
// - Workers AI stays remote (embedding a search query / the troubleshooter is inference, no stored state).
{
  "$schema": "../../worker/node_modules/wrangler/config-schema.json",
  "name": "gearcast-capture",
  "main": "../../worker/src/index.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {
    "directory": "./.dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/docs/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  "d1_databases": [{ "binding": "DB", "database_name": "gearcast-capture-db", "database_id": "00000000-0000-0000-0000-00000000ca97" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "gearcast-capture-files" }],
  "vars": { "DEEPSEEK_BASE_URL": "https://api.deepseek.com", "DEEPSEEK_MODEL": "deepseek-flash", "TZ_OFFSET_MIN": "480",
    "LIMIT_LLM_CALLS_DAY": "300", "LIMIT_EMBED_TEXTS_DAY": "5000", "LIMIT_UPLOADS_DAY": "30", "LIMIT_UPLOAD_MB_DAY": "200",
    "LIMIT_PDF_WRITES_DAY": "300", "LIMIT_PHOTOS_DAY": "100", "LIMIT_STORAGE_MB": "2048" }
}
