{
  "name": "gearcast-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "GearCast MVP promo video (Remotion)",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts GearcastPromo out/gearcast-promo.mp4 --codec=h264 --crf=16 --pixel-format=yuv420p --audio-bitrate=320k",
    "render:showcase": "remotion render src/index.ts ComponentShowcase out/showcase.mp4 --codec=h264 --crf=18",
    "still": "node scripts/still.mjs",
    "typecheck": "tsc --noEmit",
    "demo-capture": "node scripts/demo-capture.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.547",
    "@remotion/cli": "4.0.547",
    "@remotion/fonts": "4.0.547",
    "@remotion/media-utils": "4.0.547",
    "@remotion/renderer": "4.0.547",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "remotion": "4.0.547"
  },
  "devDependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "24.19.4",
    "@types/react": "19.2.18",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
